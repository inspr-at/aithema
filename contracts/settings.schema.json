{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/inspr-at/aithema/contracts/settings.schema.json",
  "title": "Settings aithema.settings/1 (§2.4, §2.5, §9.3, §9.7)",
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "major",
        "minor",
        "min_reader",
        "country_sets",
        "provider_templates",
        "evidence",
        "presets",
        "policy",
        "hosting",
        "voice",
        "defaults"
      ],
      "properties": {
        "contract": {
          "const": "aithema.settings"
        },
        "major": {
          "const": 1
        },
        "minor": {
          "$ref": "common.schema.json#/$defs/minor"
        },
        "min_reader": {
          "$ref": "common.schema.json#/$defs/minor"
        },
        "country_sets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/country_set"
          }
        },
        "provider_templates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/template"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "presets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "local-l1",
            "eu-e1",
            "cloud-c1"
          ],
          "properties": {
            "local-l1": {
              "$ref": "#/$defs/preset"
            },
            "eu-e1": {
              "$ref": "#/$defs/preset"
            },
            "cloud-c1": {
              "$ref": "#/$defs/preset"
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "egress",
            "residency",
            "spend"
          ],
          "properties": {
            "egress": {
              "$ref": "#/$defs/egress"
            },
            "residency": {
              "$ref": "#/$defs/residency"
            },
            "spend": {
              "$ref": "#/$defs/spend"
            }
          }
        },
        "hosting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commercial",
            "region_placement",
            "proxy",
            "ca_bundle"
          ],
          "properties": {
            "commercial": {
              "type": "boolean"
            },
            "region_placement": {
              "$ref": "#/$defs/set_refs"
            },
            "proxy": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/endpoint"
                }
              ]
            },
            "ca_bundle": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "common.schema.json#/$defs/ref"
                }
              ]
            }
          }
        },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transport"
          ],
          "properties": {
            "transport": {
              "const": "inline"
            },
            "vad": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "adapter",
                "threshold",
                "max_frame_ms"
              ],
              "properties": {
                "adapter": {
                  "const": "pcm-energy-vad"
                },
                "threshold": {
                  "type": "number",
                  "maximum": 1,
                  "minimum": 0.000001
                },
                "max_frame_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              "description": "Optional bounded inline PCM16 energy VAD. Activity only; no end-of-turn quality claim."
            }
          }
        },
        "defaults": {
          "$ref": "#/$defs/preferences"
        }
      },
      "description": "Instance settings v1. All objects are strict. Preset egress and residency narrow instance policy. The instance defaults keep voice off; a session may explicitly enable inline voice. References never contain secret values. Evidence, account pairing, residency, egress and licence predicates are executed by runtime/settings, never by the foundation validator."
    },
    "country_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "countries"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/set_id"
        },
        "countries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 249,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/country"
          }
        }
      }
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "set_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9+_-]{0,31}@20[0-9]{2}-(?:0[1-9]|1[0-2])$"
    },
    "set_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/set_id"
      }
    },
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow"
      ],
      "properties": {
        "allow": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        }
      }
    },
    "residency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_countries"
      ],
      "properties": {
        "allowed_countries": {
          "$ref": "#/$defs/set_refs"
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "adapter",
        "product",
        "deployment",
        "endpoint",
        "location",
        "evidence_ref",
        "account_ref",
        "secret",
        "models",
        "voices",
        "artifacts"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "provider": {
          "enum": [
            "local",
            "mistral",
            "openai",
            "elevenlabs",
            "synthetic"
          ]
        },
        "adapter": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "product": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "deployment": {
          "enum": [
            "api",
            "self_hosted"
          ]
        },
        "endpoint": {
          "$ref": "#/$defs/endpoint"
        },
        "location": {
          "enum": [
            "operator",
            "cloud"
          ]
        },
        "evidence_ref": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "account_ref": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "secret": {
          "$ref": "#/$defs/secret"
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/ref"
          }
        },
        "voices": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/ref"
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "account_ref",
        "owner"
      ],
      "properties": {
        "kind": {
          "enum": [
            "api_key_ref",
            "service_token_ref"
          ]
        },
        "ref": {
          "type": "string",
          "pattern": "^secret:[A-Za-z0-9][A-Za-z0-9._:-]{0,120}$"
        },
        "account_ref": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "owner": {
          "const": "operator"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "product",
        "licence",
        "bundled",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "code",
            "native",
            "weights",
            "voice"
          ]
        },
        "product": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "licence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "bundled": {
          "type": "boolean"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "template_ref",
        "account_ref",
        "owner",
        "account_tier",
        "document_ref",
        "secret_binding",
        "countries",
        "retention",
        "training_on_content",
        "opt_out",
        "verified_at",
        "expires_at"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "template_ref": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "account_ref": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "owner": {
          "const": "operator"
        },
        "account_tier": {
          "enum": [
            "standard",
            "enterprise"
          ]
        },
        "document_ref": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "secret_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "account_ref",
            "attested",
            "document_ref"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^secret:[A-Za-z0-9][A-Za-z0-9._:-]{0,120}$"
            },
            "account_ref": {
              "$ref": "common.schema.json#/$defs/ref"
            },
            "attested": {
              "type": "boolean"
            },
            "document_ref": {
              "$ref": "common.schema.json#/$defs/ref"
            }
          }
        },
        "countries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inference",
            "storage",
            "logs"
          ],
          "properties": {
            "inference": {
              "$ref": "#/$defs/set_refs"
            },
            "storage": {
              "$ref": "#/$defs/set_refs"
            },
            "logs": {
              "$ref": "#/$defs/set_refs"
            }
          }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zero_retention_entitled",
            "exceptions"
          ],
          "properties": {
            "zero_retention_entitled": {
              "type": "boolean"
            },
            "exceptions": {
              "type": "array",
              "minItems": 0,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "purpose",
                  "max_days",
                  "document_ref"
                ],
                "properties": {
                  "purpose": {
                    "enum": [
                      "security",
                      "legal",
                      "abuse",
                      "service"
                    ]
                  },
                  "max_days": {
                    "$ref": "common.schema.json#/$defs/count"
                  },
                  "document_ref": {
                    "$ref": "common.schema.json#/$defs/ref"
                  }
                }
              }
            }
          }
        },
        "training_on_content": {
          "type": "boolean",
          "description": "Whether the product may train on content absent the evidenced account opt-out. true is admissible only with opt_out.active for this exact account."
        },
        "opt_out": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "account_ref",
                "active",
                "document_ref"
              ],
              "properties": {
                "account_ref": {
                  "$ref": "common.schema.json#/$defs/ref"
                },
                "active": {
                  "type": "boolean"
                },
                "document_ref": {
                  "$ref": "common.schema.json#/$defs/ref"
                }
              }
            }
          ]
        },
        "verified_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_ref",
        "model"
      ],
      "properties": {
        "template_ref": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "model": {
          "$ref": "common.schema.json#/$defs/ref"
        }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lanes",
        "egress",
        "residency"
      ],
      "properties": {
        "lanes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reaction",
            "spec",
            "design",
            "stt",
            "tts"
          ],
          "properties": {
            "reaction": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/selection"
                }
              ]
            },
            "spec": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/selection"
                }
              ]
            },
            "design": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/selection"
                }
              ]
            },
            "stt": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/selection"
                }
              ]
            },
            "tts": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/selection"
                }
              ]
            }
          }
        },
        "egress": {
          "$ref": "#/$defs/egress"
        },
        "residency": {
          "$ref": "#/$defs/residency"
        }
      }
    },
    "spend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "fx",
        "caps",
        "provider_max"
      ],
      "properties": {
        "currency": {
          "$ref": "common.schema.json#/$defs/currency"
        },
        "fx": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "numerator",
              "denominator",
              "as_of"
            ],
            "properties": {
              "from": {
                "$ref": "common.schema.json#/$defs/currency"
              },
              "to": {
                "$ref": "common.schema.json#/$defs/currency"
              },
              "numerator": {
                "$ref": "common.schema.json#/$defs/positive"
              },
              "denominator": {
                "$ref": "common.schema.json#/$defs/positive"
              },
              "as_of": {
                "$ref": "common.schema.json#/$defs/timestamp"
              }
            }
          }
        },
        "caps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_micro",
            "principal_day_micro",
            "tenant_day_micro"
          ],
          "properties": {
            "session_micro": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "principal_day_micro": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "tenant_day_micro": {
              "$ref": "common.schema.json#/$defs/count"
            }
          }
        },
        "provider_max": {
          "description": "Per-lane reservation ceilings. Zero is executable only for enabled operator self-hosted inference on a loopback endpoint, with a host-registered operator_local budget lane; admission and single-use claim still precede dispatch.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reaction",
            "spec",
            "design",
            "stt",
            "tts"
          ],
          "properties": {
            "reaction": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "spec": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "design": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "stt": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "tts": {
              "$ref": "common.schema.json#/$defs/count"
            }
          }
        },
        "deployment_period": {
          "$ref": "budget.schema.json#/$defs/deployment_period_settings"
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset",
        "language",
        "address",
        "voice"
      ],
      "properties": {
        "preset": {
          "enum": [
            "local-l1",
            "eu-e1",
            "cloud-c1"
          ]
        },
        "language": {
          "$ref": "common.schema.json#/$defs/lang"
        },
        "address": {
          "enum": [
            "formal",
            "informal"
          ]
        },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "tts_voice"
          ],
          "properties": {
            "enabled": {
              "const": false
            },
            "tts_voice": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "common.schema.json#/$defs/ref"
                }
              ]
            }
          }
        }
      }
    }
  }
}
