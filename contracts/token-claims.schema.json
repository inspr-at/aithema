{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/inspr-at/aithema/contracts/token-claims.schema.json",
  "title": "Session and delegated token claims (§6.1, §6.2)",
  "description": "Descriptor of the JWT claim sets a host mints after preallocating sid and creating the journal session. session: audience aithema, carried by the browser. delegated: audience = the host, sub = the plugin principal, act.sub = the person; it carries only the capabilities of capabilities.json and never an acceptance capability. Both live at most 15 minutes; refresh goes through the host and is issued for the current generation only.",
  "$defs": {
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "major", "minor", "min_reader", "token", "claims"],
      "properties": {
        "contract": { "const": "aithema.token.claims" },
        "major": { "const": 1 },
        "minor": { "$ref": "common.schema.json#/$defs/minor" },
        "min_reader": { "$ref": "common.schema.json#/$defs/minor" },
        "token": { "enum": ["session", "delegated"] },
        "claims": { "type": "object" }
      },
      "oneOf": [
        { "required": ["token", "claims"], "properties": { "token": { "const": "session" }, "claims": { "$ref": "#/$defs/session" } } },
        { "required": ["token", "claims"], "properties": { "token": { "const": "delegated" }, "claims": { "$ref": "#/$defs/delegated" } } }
      ]
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iss", "aud", "sub", "tid", "pid", "sid", "scope", "actor_kind", "host_mode", "auth_epoch", "iat", "exp"],
      "properties": {
        "iss": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "aud": { "const": "aithema" },
        "sub": { "$ref": "common.schema.json#/$defs/ref" },
        "tid": { "$ref": "common.schema.json#/$defs/ref" },
        "pid": { "$ref": "common.schema.json#/$defs/ref" },
        "sid": { "$ref": "common.schema.json#/$defs/uuid" },
        "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["session.converse", "session.upload", "session.confirm", "session.export"] } },
        "actor_kind": { "enum": ["person", "anonymous"] },
        "host_mode": { "$ref": "common.schema.json#/$defs/host_mode" },
        "auth_epoch": { "$ref": "common.schema.json#/$defs/positive" },
        "iat": { "$ref": "common.schema.json#/$defs/count" },
        "exp": { "$ref": "common.schema.json#/$defs/count" },
        "jti": { "$ref": "common.schema.json#/$defs/uuid" }
      }
    },
    "delegated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iss", "aud", "sub", "act", "tid", "pid", "sid", "gen", "auth_epoch", "capabilities", "iat", "exp"],
      "properties": {
        "iss": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "aud": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sub": { "$ref": "common.schema.json#/$defs/ref" },
        "act": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sub"],
          "properties": { "sub": { "$ref": "common.schema.json#/$defs/ref" } }
        },
        "tid": { "$ref": "common.schema.json#/$defs/ref" },
        "pid": { "$ref": "common.schema.json#/$defs/ref" },
        "sid": { "$ref": "common.schema.json#/$defs/uuid" },
        "gen": { "$ref": "common.schema.json#/$defs/positive" },
        "auth_epoch": { "$ref": "common.schema.json#/$defs/positive" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z_]*(\\.[a-z_]+)+$" }
        },
        "iat": { "$ref": "common.schema.json#/$defs/count" },
        "exp": { "$ref": "common.schema.json#/$defs/count" },
        "jti": { "$ref": "common.schema.json#/$defs/uuid" }
      }
    }
  }
}
