        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/button"
        },
        {
          "$ref": "#/$defs/link"
        },
        {
          "$ref": "#/$defs/input"
        },
        {
          "$ref": "#/$defs/textarea"
        },
        {
          "$ref": "#/$defs/select"
        },
        {
          "$ref": "#/$defs/checkbox"
        },
        {
          "$ref": "#/$defs/radio"
        },
        {
          "$ref": "#/$defs/switch"
        },
        {
          "$ref": "#/$defs/badge"
        },
