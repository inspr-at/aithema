{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/inspr-at/aithema/contracts/screen.schema.json",
  "title": "aithema.screen/1, vocabulary v1 (22 components)",
  "description": "IR only: no HTML, URLs, arbitrary CSS, attributes or event handlers. IDs are screen-local. Images are labelled placeholders. Links target screen-local node ids. Maximum canonical bytes: 512 KiB; 2000 nodes; 16 component levels. Minor 1 persists renderer_version and generator_id inside the immutable IR; execution requires min_reader >= 1. Artefact identity still hashes the canonical four-input tuple.",
  "$defs": {
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "children"
      ],
      "properties": {
        "kind": {
          "const": "stack"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
        },
        "children": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "children"
      ],
      "properties": {
        "kind": {
          "const": "row"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
        },
        "children": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "children",
        "columns"
      ],
      "properties": {
        "kind": {
          "const": "grid"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
        },
        "children": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "label",
        "children"
      ],
      "properties": {
        "kind": {
          "const": "section"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "children": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "label",
        "children"
      ],
      "properties": {
        "kind": {
          "const": "card"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "children": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "text",
        "level"
      ],
      "properties": {
        "kind": {
          "const": "heading"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "label",
        "variant"
      ],
      "properties": {
        "kind": {
          "const": "button"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "variant": {
          "enum": [
            "primary",
            "secondary"
          ]
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "label",
        "target"
      ],
      "properties": {
        "kind": {
          "const": "link"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "label",
        "value",
        "input_type"
      ],
      "properties": {
        "kind": {
          "const": "input"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "value": {
          "type": "string",
          "maxLength": 4000
        },
        "input_type": {
          "enum": [
            "text",
            "email",
            "number",
            "search"
          ]
        }
      }
    },
    "textarea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
