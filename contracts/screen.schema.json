    "generator_id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "prompt_version"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "major",
        "minor",
        "min_reader",
        "vocabulary",
        "screen_ref",
        "title",
        "lang",
        "nodes",
        "renderer_version",
        "generator_id"
      ],
      "properties": {
        "contract": {
          "const": "aithema.screen"
        },
        "major": {
          "const": 1
        },
        "minor": {
          "$ref": "common.schema.json#/$defs/minor"
        },
        "min_reader": {
          "$ref": "common.schema.json#/$defs/minor"
        },
        "vocabulary": {
          "const": 1
        },
        "screen_ref": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "lang": {
          "$ref": "common.schema.json#/$defs/lang"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "renderer_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$(?![\\s\\S])"
        },
        "generator_id": {
          "$ref": "#/$defs/generator_id"
        }
      }
