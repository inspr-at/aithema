{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/inspr-at/aithema/contracts/design-tokens.schema.json",
  "title": "Design tokens v1: typed CSS values only",
  "$defs": {
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "major",
        "minor",
        "min_reader",
        "color",
        "space",
        "radius",
        "font_family",
        "font_size"
      ],
      "properties": {
        "contract": {
          "const": "aithema.design.tokens"
        },
        "major": {
          "const": 1
        },
        "minor": {
          "$ref": "common.schema.json#/$defs/minor"
        },
        "min_reader": {
          "$ref": "common.schema.json#/$defs/minor"
        },
        "color": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "surface",
            "ink",
            "muted",
            "primary",
            "on_primary",
            "border"
          ],
          "properties": {
            "surface": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$(?![\\s\\S])"
            },
            "ink": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$(?![\\s\\S])"
            },
            "muted": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$(?![\\s\\S])"
            },
            "primary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$(?![\\s\\S])"
            },
            "on_primary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$(?![\\s\\S])"
            },
            "border": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$(?![\\s\\S])"
            }
          }
        },
        "space": {
          "type": "number",
          "minimum": 0,
          "maximum": 64
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 64
        },
        "font_family": {
          "enum": [
            "sans",
            "serif",
            "monospace"
          ]
        },
        "font_size": {
          "type": "number",
          "minimum": 10,
          "maximum": 32
        }
      }
    }
  }
}
