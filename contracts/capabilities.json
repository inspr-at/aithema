{
  "description": "Least-privilege capability and route matrix (§6.2). Capability names are exact strings in the host's scope registry and agent-grantable (aithema.ledger is one aggregate capability). Fencing is enforced in the host: journal, ledger and intake handlers compare the token's gen with the session's current generation and reject stale ones with fenced_generation; Aithema's outbound gate is a second check. Acceptance is never in any token. JWT expiry (exp) is verified on every delegated route.",
  "token_max_lifetime_seconds": 900,
  "delegated_allowed": [
    "intake.read",
    "intake.write",
    "aithema.journal.read",
    "aithema.journal.write",
    "aithema.authority.read",
    "aithema.ledger"
  ],
  "never_in_token": [
    "intake.decide",
    "intake.accept",
    "nodes.write"
  ],
  "routes": [
    {
      "route": "POST …/intake/sources | …/transcript-turns | …/drafts | …/drafts/{id}/replace",
      "class": "write",
      "capability": "intake.write",
      "checks": [
        "tid",
        "pid",
        "sid",
        "gen",
        "epoch",
        "exp",
        "ephemeral LiveGrant"
      ]
    },
    {
      "route": "GET …/intake",
      "class": "read",
      "capability": "intake.read",
      "checks": [
        "tid",
        "pid",
        "sid",
        "epoch",
        "exp"
      ]
    },
    {
      "route": "POST …/drafts/{id}/accept",
      "class": "person-only",
      "capability": "intake.decide",
      "checks": [
        "person session auth",
        "intake.decide (person role, never a token)"
      ]
    },
    {
      "route": "POST /journal/sessions/{sid}/records | snapshots | op.result",
      "class": "write",
      "capability": "aithema.journal.write",
      "checks": [
        "tid",
        "pid",
        "sid",
        "gen",
        "epoch",
        "exp"
      ]
    },
    {
      "route": "GET /journal/sessions/{sid}/records | …/cursor",
      "class": "read",
      "capability": "aithema.journal.read",
      "checks": [
        "tid",
        "pid",
        "sid",
        "epoch",
        "exp"
      ]
    },
    {
      "route": "GET /journal/sessions/{sid}/authority",
      "class": "read",
      "capability": "aithema.authority.read",
      "checks": [
        "tid",
        "sid",
        "exp"
      ],
      "response": "Cache-Control: no-store; carries issued_at"
    },
    {
      "route": "ledger admit | claim | settle",
      "class": "control",
      "capability": "aithema.ledger",
      "checks": [
        "tid",
        "pid",
        "sid",
        "gen",
        "epoch",
        "exp"
      ]
    },
    {
      "route": "ledger recover(hold_id)",
      "class": "control",
      "capability": "aithema.ledger",
      "checks": [
        "tid",
        "pid",
        "sid",
        "gen = current only",
        "epoch",
        "exp"
      ]
    },
    {
      "route": "GET /ledger/sessions/{sid}/holds?state=open",
      "class": "read",
      "capability": "aithema.ledger",
      "checks": [
        "tid",
        "pid",
        "sid",
        "epoch",
        "exp"
      ],
      "response": "uncached; authoritative"
    },
    {
      "route": "POST /v1/sessions | /v1/sessions/{sid}/host-event | …/revoke | …/context",
      "class": "host-to-service",
      "capability": "host service credential",
      "checks": [
        "sid"
      ]
    }
  ],
  "authority": {
    "request_deadline_seconds": 10,
    "poll_interval_seconds": 30,
    "stale_after_seconds": 30,
    "stop_allowance_seconds": 5,
    "revocation_healthy_max_seconds": 45,
    "revocation_outage_max_seconds": 75,
    "end_after_no_authority_seconds": 600
  },
  "token_verification": {
    "algorithms": [
      "EdDSA",
      "ES256"
    ],
    "kid_required": true,
    "iss": "exact string match against the configured issuer",
    "aud": "exact string match (session: aithema; delegated: the host audience)",
    "max_clock_skew_seconds": 60,
    "iat": "refuse iat more than max_clock_skew_seconds in the future",
    "exp": "refuse exp ≤ now − max_clock_skew_seconds; exp − iat ≤ token_max_lifetime_seconds",
    "key_rotation_overlap": "a retired key stays in the JWKS for at least token_max_lifetime_seconds + max_clock_skew_seconds after its last issued token",
    "jti": "optional; replay is handled by per-operation idempotency keys and single-use budget claims, not by jti tracking"
  }
}
