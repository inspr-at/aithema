{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/inspr-at/aithema/contracts/element-event.schema.json",
  "title": "<aithema-session> DOM events (AIT-76, minimal v1 element)",
  "description": "Events the minimal element dispatches to its host page. Attributes: service-url (https base of the Aithema service), sid, lang, host-mode. The session token is set through the accessToken property, never an attribute, so it never appears in the DOM. The element owns the trusted full-item confirmation view; hosts observe outcomes through these events and cannot confirm on the person's behalf.",
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "major", "minor", "min_reader", "type", "detail"],
      "properties": {
        "contract": { "const": "aithema.element.event" },
        "major": { "const": 1 },
        "minor": { "$ref": "common.schema.json#/$defs/minor" },
        "min_reader": { "$ref": "common.schema.json#/$defs/minor" },
        "type": { "enum": ["aithema-state", "aithema-submitted", "aithema-error", "aithema-ended"] },
        "detail": { "type": "object" }
      },
      "oneOf": [
        {
          "required": ["type", "detail"],
          "properties": {
            "type": { "const": "aithema-state" },
            "detail": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state"],
              "properties": { "state": { "enum": ["connecting", "ready", "capture_only", "suspended", "ended"] } }
            }
          }
        },
        {
          "required": ["type", "detail"],
          "properties": {
            "type": { "const": "aithema-submitted" },
            "detail": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item_refs", "working_rev"],
              "properties": {
                "item_refs": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "common.schema.json#/$defs/ref" } },
                "working_rev": { "$ref": "common.schema.json#/$defs/positive" }
              }
            }
          }
        },
        {
          "required": ["type", "detail"],
          "properties": {
            "type": { "const": "aithema-error" },
            "detail": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code"],
              "properties": { "code": { "$ref": "common.schema.json#/$defs/error_code" }, "message": { "type": "string", "maxLength": 500 } }
            }
          }
        },
        {
          "required": ["type", "detail"],
          "properties": {
            "type": { "const": "aithema-ended" },
            "detail": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason", "export"],
              "properties": {
                "reason": { "enum": ["person", "timeout", "authority_lost", "capture_only_timeout", "host", "revoked"] },
                "export": { "enum": ["exported", "offered", "none"] }
              }
            }
          }
        }
      ]
    }
  }
}
