{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/inspr-at/aithema/contracts/extension.schema.json",
  "title": "Typed domain analysis extension (AIT-79)",
  "description": "Pure registration accepts the four-field descriptor. The registered contract also accepts the standard envelope for compatibility fixtures. Schema depth counts schema nodes starting with the root at 1; enum-only nodes are finite value sets. Instance byte limits include version and data; the item limit includes the complete extensions map.",
  "$defs": {
    "extension": {
      "properties": {
        "contract": {
          "const": "aithema.extension"
        },
        "major": {
          "const": 1
        },
        "minor": {
          "$ref": "common.schema.json#/$defs/minor"
        },
        "min_reader": {
          "$ref": "common.schema.json#/$defs/minor"
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/descriptor"
        },
        {
          "$ref": "#/$defs/enveloped"
        }
      ]
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "version",
        "schema",
        "title"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^x-[a-z0-9]+(\\.[a-z0-9-]+)+$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "maxLength": 33
        },
        "schema": {
          "$ref": "#/$defs/schema"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "enveloped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "major",
        "minor",
        "min_reader",
        "namespace",
        "version",
        "schema",
        "title"
      ],
      "properties": {
        "contract": {
          "const": "aithema.extension"
        },
        "major": {
          "const": 1
        },
        "minor": {
          "$ref": "common.schema.json#/$defs/minor"
        },
        "min_reader": {
          "$ref": "common.schema.json#/$defs/minor"
        },
        "namespace": {
          "type": "string",
          "pattern": "^x-[a-z0-9]+(\\.[a-z0-9-]+)+$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "maxLength": 33
        },
        "schema": {
          "$ref": "#/$defs/schema"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "schema": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "additionalProperties",
            "properties"
          ],
          "properties": {
            "type": {
              "const": "object"
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": true
            },
            "additionalProperties": {
              "const": false
            },
            "properties": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/schema"
              }
            },
            "required": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "maxItems",
            "items"
          ],
          "properties": {
            "type": {
              "const": "array"
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": true
            },
            "maxItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "items": {
              "$ref": "#/$defs/schema"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "maxLength"
          ],
          "properties": {
            "type": {
              "const": "string"
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": true
            },
            "maxLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "number"
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "integer"
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enum"
          ],
          "properties": {
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": true
            }
          }
        }
      ]
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "data"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "maxLength": 33
        },
        "data": true
      }
    },
    "instances": {
      "type": "object",
      "maxProperties": 8,
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9]+(\\.[a-z0-9-]+)+@(0|[1-9][0-9]*)$": {
          "$ref": "#/$defs/instance"
        }
      }
    }
  }
}
