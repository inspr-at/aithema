{
  "name": "aithema",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "test": "node --test packages/*/test/*.test.js plugins/*/test/*.test.js demo/test/*.test.js",
    "test:browser": "node --test test/browser/demo.test.js test/browser/html-preview.test.js test/browser/host-surface.test.js test/browser/start-journey.test.js",
    "demo": "node demo/server.js"
  },
  "devDependencies": {
    "happy-dom": "^20.11.2",
    "puppeteer-core": "25.13.0"
  },
  "version": "0.0.0",
  "description": "Embeddable requirements conversation: core, server, web components and provider plugins",
  "license": "AGPL-3.0-only"
}
