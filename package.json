{
  "name": "aithema",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "test": "node --test --test-timeout=180000 --import ./scripts/unit-watchdog.js packages/*/test/*.test.js plugins/*/test/*.test.js demo/test/*.test.js test/*.test.js",
    "test:browser": "node scripts/test-browser.js",
    "update:browser-timings": "node scripts/update-browser-timings.js",
    "test:browser-shards": "node scripts/browser-shards.js",
    "test:voice-soak": "node scripts/voice-soak.js",
    "demo": "node demo/server.js",
    "release:dry-run": "node release/dry-run.mjs",
    "release:pack": "node release/pack.mjs pack",
    "release:verify": "node release/pack.mjs verify",
    "release:consumer": "node release/consumer.mjs",
    "release:candidate": "node release/candidate.mjs",
    "setup:browser": "node scripts/install-test-browser.js"
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.2.4",
    "axe-core": "4.10.3",
    "happy-dom": "^20.11.2",
    "puppeteer-core": "25.13.0",
    "typescript": "5.9.3",
    "ws": "8.22.0",
    "yaml": "2.8.2"
  },
  "version": "261021073740.0.0",
  "description": "Embeddable requirements conversation: core, server, web components and provider plugins",
  "license": "AGPL-3.0-only"
}
