{
  "name": "@inspr/aithema-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable requirements assistant: stable IDs, revision digests, baseline approval, and proposal boundaries",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": "./lib/index.js",
    "./runtime": "./runtime/index.js",
    "./workspace": "./workspace/index.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:packaging": "node --test test/packaging.test.js",
    "test:source-export": "node --test test/source-export.test.js",
    "release:build": "node release/build-release.mjs",
    "source:export": "node release/build-source.mjs",
    "verify:license": "node release/verify-license.mjs",
    "example": "node examples/consumer.js",
    "workspace": "node examples/workspace.js"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.2.5",
    "fontkit": "2.0.4",
    "pdfkit": "0.17.2",
    "unpdf": "1.8.0"
  }
}
